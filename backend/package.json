{
  "name": "@concierge/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/server.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    },
    "./catalog": {
      "types": "./dist/team-catalog.d.ts",
      "import": "./dist/team-catalog.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./agreed-catalog": {
      "types": "./dist/agreed-catalog.d.ts",
      "import": "./dist/agreed-catalog.js"
    },
    "./quotes": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    }
  }
}
