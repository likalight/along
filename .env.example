# Optional: enables provider voice session mint and, when explicitly enabled,
# discovery vision. Keep this and all Coupang credentials on the server.
# Text mode works without this key; voice mint returns not_connected when unset.
OPENAI_API_KEY=

# Host port published by docker compose (container always listens on 3000).
ALONG_PORT=3000

# Optional Chrome companion: search mode needs only OPENAI_API_KEY.
# Set provider to search for AI recognition + ordinary Coupang search links.
# Optional web search adds source-backed public product links, never price/stock claims.
# Set provider to coupang only after confirming this extension use with Coupang.
# The approval flag is an operator assertion, not a request for API/placement approval.
ALONG_DISCOVERY_PROVIDER=
ALONG_DISCOVERY_WEB_SEARCH=false
ALONG_DISCOVERY_WEB_MODEL=gpt-4.1-mini
COUPANG_PARTNERS_APPROVED=false
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# Only the documented v1 and legacy products/search paths are accepted.
COUPANG_SEARCH_PATH=/v2/providers/affiliate_open_api/apis/openapi/v1/products/search

# Optional video/photo-crop interpretation; requires search or coupang mode and OPENAI_API_KEY.
# May incur provider charges. Demo mode never invokes these providers.
ALONG_DISCOVERY_VISION=false
ALONG_DISCOVERY_VISION_MODEL=gpt-4.1-mini
