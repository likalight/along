{
  "manifest_version": 3,
  "name": "Along — a little discovery, as you browse",
  "version": "0.2.0",
  "description": "With your permission, Along notices products on supported sites and brings Coupang discoveries into your existing Along conversation.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "sidePanel", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": { "service_worker": "src/worker.js", "type": "module" },
  "action": { "default_title": "Open Along" },
  "side_panel": { "default_path": "ui/panel.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'" }
}
